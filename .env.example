# Local development only. Never commit real secrets.
#
# For a public APK/AAB, keep sensitive API calls behind Cloud Functions or
# another backend proxy. The Flutter app should work with local fallbacks when
# these values are absent.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=gpt-4.1-mini

STABILITY_API_KEY=
SERPAPI_KEY=
YOUTUBE_API_KEY=
REPLICATE_API_KEY=
SEGMIND_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_IMAGE_UPLOAD_PRESET=
CLOUDINARY_VIDEO_UPLOAD_PRESET=
CLOUDINARY_FILE_UPLOAD_PRESET=
CLOUDINARY_FOLDER_ROOT=elegantstyle

ENABLE_DEFAULT_ADMIN_BOOTSTRAP=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrateur ElegantStyle
