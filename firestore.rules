rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Définition des fonctions utilitaires
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function rolesHas(role) {
      return getUserData().roles is list && getUserData().roles.hasAny([role]);
    }
    
    function isAdmin() {
      return getRole() == 'admin'
        || getUserData().activeRole == 'admin'
        || rolesHas('admin')
        || getUserData().roleFlags.isAdmin == true;
    }
    
    function isCreator() {
      return getRole() == 'createur'
        || getUserData().activeRole == 'createur'
        || rolesHas('createur')
        || getUserData().roleFlags.isCreator == true;
    }
    
    function isShop() {
      return getRole() == 'boutique'
        || getUserData().activeRole == 'boutique'
        || rolesHas('boutique')
        || getUserData().roleFlags.isShop == true;
    }

    function hasActiveSignatureAccess() {
      let subscription = get(/databases/$(database)/documents/seller_subscriptions/$(request.auth.uid)).data;
      let entitlements = getUserData().businessEntitlements;
      return (
          subscription is map
          && 
          subscription.status == 'active'
          && subscription.expiresAt > request.time
          && subscription.plan in ['premium', 'signature']
        )
        || (
          entitlements is map
          && entitlements.status == 'active'
          && entitlements.expiresAt > request.time
          && entitlements.plan in ['premium', 'signature']
        );
    }
    
    function isClient() {
      return getRole() == 'client'
        || getUserData().activeRole == 'client'
        || rolesHas('client')
        || getUserData().roleFlags.isClient == true;
    }
    
    function isUser(userId) {
      return request.auth.uid == userId;
    }

    function gamificationPoints() {
      return getUserData().gamification.lifetimePoints is number
        ? getUserData().gamification.lifetimePoints
        : (getUserData().gamification.points is number
          ? getUserData().gamification.points
          : 0);
    }

    function secondhandVisibilityIsEarned() {
      return (gamificationPoints() >= 2500
          && request.resource.data.visibilityTierId == 'ambassador'
          && request.resource.data.recommendationWeight == 70)
        || (gamificationPoints() >= 1200
          && gamificationPoints() < 2500
          && request.resource.data.visibilityTierId == 'trusted'
          && request.resource.data.recommendationWeight == 45)
        || (gamificationPoints() >= 600
          && gamificationPoints() < 1200
          && request.resource.data.visibilityTierId == 'curator'
          && request.resource.data.recommendationWeight == 25)
        || (gamificationPoints() < 600
          && request.resource.data.visibilityTierId == 'explorer'
          && request.resource.data.recommendationWeight == 10);
    }

    function ownsCommerceContent() {
      return resource.data.ownerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || resource.data.boutiqueId == request.auth.uid
        || resource.data.shopId == request.auth.uid
        || resource.data.creatorId == request.auth.uid
        || resource.data.createurId == request.auth.uid;
    }

    function createsOwnedCommerceContent() {
      return request.resource.data.ownerId == request.auth.uid
        || request.resource.data.sellerId == request.auth.uid
        || request.resource.data.boutiqueId == request.auth.uid
        || request.resource.data.shopId == request.auth.uid
        || request.resource.data.creatorId == request.auth.uid
        || request.resource.data.createurId == request.auth.uid;
    }

    function allProvidedCommerceIdentityBelongsToUser() {
      return (!request.resource.data.keys().hasAny(['ownerId'])
          || request.resource.data.ownerId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['sellerId'])
          || request.resource.data.sellerId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['boutiqueId'])
          || request.resource.data.boutiqueId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['shopId'])
          || request.resource.data.shopId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['creatorId'])
          || request.resource.data.creatorId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['createurId'])
          || request.resource.data.createurId == request.auth.uid);
    }

    function existingCommerceIdentityBelongsToUser() {
      return (!resource.data.keys().hasAny(['ownerId'])
          || resource.data.ownerId == request.auth.uid)
        && (!resource.data.keys().hasAny(['sellerId'])
          || resource.data.sellerId == request.auth.uid)
        && (!resource.data.keys().hasAny(['boutiqueId'])
          || resource.data.boutiqueId == request.auth.uid)
        && (!resource.data.keys().hasAny(['shopId'])
          || resource.data.shopId == request.auth.uid)
        && (!resource.data.keys().hasAny(['creatorId'])
          || resource.data.creatorId == request.auth.uid)
        && (!resource.data.keys().hasAny(['createurId'])
          || resource.data.createurId == request.auth.uid);
    }

    function validCurrencyField() {
      return !request.resource.data.keys().hasAny(['currency'])
        || (request.resource.data.currency is string
          && request.resource.data.currency.size() >= 3
          && request.resource.data.currency.size() <= 5);
    }

    function keepsCommerceIdentity() {
      return (!resource.data.keys().hasAny(['ownerId'])
          || request.resource.data.ownerId == resource.data.ownerId)
        && (!resource.data.keys().hasAny(['sellerId'])
          || request.resource.data.sellerId == resource.data.sellerId)
        && (!resource.data.keys().hasAny(['sellerRole'])
          || request.resource.data.sellerRole == resource.data.sellerRole)
        && (!resource.data.keys().hasAny(['boutiqueId'])
          || request.resource.data.boutiqueId == resource.data.boutiqueId)
        && (!resource.data.keys().hasAny(['shopId'])
          || request.resource.data.shopId == resource.data.shopId)
        && (!resource.data.keys().hasAny(['creatorId'])
          || request.resource.data.creatorId == resource.data.creatorId)
        && (!resource.data.keys().hasAny(['createurId'])
          || request.resource.data.createurId == resource.data.createurId);
    }

    function clientConfirmsOrderReceipt() {
      return resource.data.userId == request.auth.uid
        && resource.data.paymentStatus == 'paid'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.sellerRole == resource.data.sellerRole
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.status == 'received_by_customer'
        && request.resource.data.orderStatus == 'received_by_customer'
        && request.resource.data.managedPaymentStatus == 'withdrawal_available'
        && request.resource.data.sellerBalanceStatus == 'available'
        && request.resource.data.sellerBalance.pendingBalance == 0
        && request.resource.data.sellerBalance.availableBalance == resource.data.sellerPayout
        && request.resource.data.sellerBalance.expectedSellerAmount == resource.data.sellerPayout
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'orderStatus',
          'sellerBalance',
          'sellerBalanceStatus',
          'managedPaymentStatus',
          'receivedByCustomerAt',
          'paymentTimeline',
          'updatedAt'
        ]);
    }

    function userProfileUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'roles',
        'roleFlags',
        'activeRole',
        'isAdmin',
        'permissions',
        'admin',
        'gamification',
        'stylePoints',
        'visibilityTierId',
        'recommendationWeight',
        'wallet',
        'walletBalance',
        'balance',
        'balances',
        'sellerBalance',
        'secondhandBalance',
        'secondhandBalanceStatus',
        'proEntitlements',
        'businessEntitlements',
        'subscription',
        'subscriptions',
        'sellerTrustLevel',
        'certifiedProfessional',
        'verifiedBadge',
        'certificationBadge'
      ]) == false;
    }

    function boostLifecycleSelfUpdateIsSafe() {
      return (
          !resource.data.businessEntitlements.keys().hasAny(['boost'])
          && !request.resource.data.businessEntitlements.keys().hasAny(['boost'])
        )
        || request.resource.data.businessEntitlements.boost == resource.data.businessEntitlements.boost
        || (
          resource.data.businessEntitlements.boost is map
          && request.resource.data.businessEntitlements.boost is map
          && request.resource.data.businessEntitlements.boost.diff(resource.data.businessEntitlements.boost).affectedKeys().hasOnly([
            'status',
            'expiredAt',
            'updatedAt'
          ])
          && resource.data.businessEntitlements.boost.status == 'active'
          && request.resource.data.businessEntitlements.boost.status == 'expired'
          && request.resource.data.businessEntitlements.boost.campaignId == resource.data.businessEntitlements.boost.campaignId
          && request.resource.data.businessEntitlements.boost.reference == resource.data.businessEntitlements.boost.reference
          && request.resource.data.businessEntitlements.boost.amount == resource.data.businessEntitlements.boost.amount
          && request.resource.data.businessEntitlements.boost.paymentMethod == resource.data.businessEntitlements.boost.paymentMethod
          && request.resource.data.businessEntitlements.boost.sourceRole == resource.data.businessEntitlements.boost.sourceRole
          && request.resource.data.businessEntitlements.boost.startsAt == resource.data.businessEntitlements.boost.startsAt
          && request.resource.data.businessEntitlements.boost.endsAt == resource.data.businessEntitlements.boost.endsAt
        );
    }

    function businessEntitlementLifecycleSelfUpdate() {
      return resource.data.businessEntitlements is map
        && request.resource.data.businessEntitlements is map
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'businessEntitlements',
          'updatedAt',
          'certifiedProfessional',
          'certificationBadge'
        ])
        && request.resource.data.businessEntitlements.plan == resource.data.businessEntitlements.plan
        && request.resource.data.businessEntitlements.expiresAt == resource.data.businessEntitlements.expiresAt
        && request.resource.data.businessEntitlements.amount == resource.data.businessEntitlements.amount
        && request.resource.data.businessEntitlements.currency == resource.data.businessEntitlements.currency
        && request.resource.data.businessEntitlements.startedAt == resource.data.businessEntitlements.startedAt
        && request.resource.data.businessEntitlements.durationDays == resource.data.businessEntitlements.durationDays
        && request.resource.data.businessEntitlements.paymentReference == resource.data.businessEntitlements.paymentReference
        && request.resource.data.businessEntitlements.requestId == resource.data.businessEntitlements.requestId
        && request.resource.data.businessEntitlements.approvedAt == resource.data.businessEntitlements.approvedAt
        && boostLifecycleSelfUpdateIsSafe()
        && (
          (
            resource.data.businessEntitlements.status == 'active'
            && request.resource.data.businessEntitlements.status == 'expired'
            && request.resource.data.certifiedProfessional == false
            && request.resource.data.certificationBadge == ''
          )
          || (
            request.resource.data.businessEntitlements.status == resource.data.businessEntitlements.status
            && request.resource.data.certifiedProfessional == resource.data.certifiedProfessional
            && request.resource.data.certificationBadge == resource.data.certificationBadge
          )
        );
    }

    function isOrderSeller() {
      return resource.data.sellerId == request.auth.uid
        || resource.data.boutiqueId == request.auth.uid
        || resource.data.creatorId == request.auth.uid;
    }

    function sellerUpdatesOrderProgress() {
      return isOrderSeller()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.sellerRole == resource.data.sellerRole
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && (!resource.data.keys().hasAny(['sellerPayout'])
          || request.resource.data.sellerPayout == resource.data.sellerPayout)
        && (!resource.data.keys().hasAny(['total'])
          || request.resource.data.total == resource.data.total)
        && (!resource.data.keys().hasAny(['grandTotal'])
          || request.resource.data.grandTotal == resource.data.grandTotal)
        && (!resource.data.keys().hasAny(['currency'])
          || request.resource.data.currency == resource.data.currency)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'orderStatus',
          'sellerStatus',
          'sellerConfirmationStatus',
          'preparationStatus',
          'deliveryStatus',
          'trackingCode',
          'trackingUrl',
          'readyAt',
          'preparedAt',
          'shippedAt',
          'deliveredBySellerAt',
          'sellerNote',
          'sellerTimeline',
          'paymentTimeline',
          'updatedAt'
        ]);
    }

    function canCreateOrderWithdrawalRequest() {
      return request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerBalanceStatus == 'available'
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerBalance.availableBalance == request.resource.data.amount;
    }

    function validClientCreatedOrder() {
      return request.resource.data.status == 'awaiting_admin_payment_confirmation'
        && request.resource.data.paymentStatus == 'client_marked_paid'
        && request.resource.data.managedPaymentStatus == 'client_marked_paid'
        && request.resource.data.sellerBalanceStatus == 'not_funded'
        && request.resource.data.sellerBalance is map
        && request.resource.data.sellerBalance.status == 'not_funded'
        && request.resource.data.sellerBalance.pendingBalance == 0
        && request.resource.data.sellerBalance.availableBalance == 0
        && request.resource.data.sellerBalance.withdrawnBalance == 0
        && request.resource.data.sellerBalance.disputedBalance == 0
        && request.resource.data.sellerBalance.expectedSellerAmount == request.resource.data.sellerPayout
        && request.resource.data.paymentFlow == 'admin_managed_payment'
        && request.resource.data.paymentRecipient == 'platform_admin';
    }

    function canCreateSecondhandWithdrawalRequest() {
      return request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && request.resource.data.requestType == 'secondhand_client_withdrawal'
        && exists(/databases/$(database)/documents/secondhand_listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/secondhand_listings/$(request.resource.data.listingId)).data.sellerId == request.auth.uid
        && get(/databases/$(database)/documents/secondhand_listings/$(request.resource.data.listingId)).data.secondhandBalanceStatus == 'available'
        && get(/databases/$(database)/documents/secondhand_listings/$(request.resource.data.listingId)).data.secondhandBalance.availableBalance == request.resource.data.amount;
    }

    function createsProStory() {
      return request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorRole in ['boutique', 'createur']
        && request.resource.data.status == 'active'
        && request.resource.data.visibility == 'salon'
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && ((request.resource.data.authorRole == 'boutique' && isShop())
          || (request.resource.data.authorRole == 'createur' && isCreator())
          || isAdmin());
    }

    function createsProStyleGuide() {
      return request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorRole in ['boutique', 'createur']
        && request.resource.data.status == 'published'
        && request.resource.data.visibility == 'salon'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.steps is list
        && request.resource.data.steps.size() >= 2
        && ((request.resource.data.authorRole == 'boutique' && isShop())
          || (request.resource.data.authorRole == 'createur' && isCreator())
          || isAdmin());
    }
    
    // Règles pour la collection 'users'
    match /users/{userId} {
      allow read: if isSignedIn() && (isUser(userId) || isAdmin());
      allow create: if isSignedIn()
        && (isUser(userId) || isAdmin())
        && request.resource.data.keys().hasAll(['email', 'role', 'createdAt'])
        && request.resource.data.role is string
        && request.resource.data.role in ['client', 'createur', 'boutique', 'admin']
        && request.resource.data.email is string;
      allow update: if isSignedIn()
        && (isAdmin()
          || (isUser(userId)
            && (userProfileUpdateIsSafe()
              || businessEntitlementLifecycleSelfUpdate())));
      allow delete: if isAdmin();
    }
    
    // Règles pour la collection 'createurs'
    match /createurs/{creatorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() == 'createur' && isUser(creatorId);
      allow update: if isUser(creatorId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Règles pour la collection 'boutiques'
    match /boutiques/{shopId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() == 'boutique' && isUser(shopId);
      allow update: if isUser(shopId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Règles pour la collection 'clients'
    match /clients/{clientId} {
      allow read: if isSignedIn() && (isUser(clientId) || isAdmin());
      allow create: if isSignedIn() && getRole() == 'client' && isUser(clientId);
      allow update: if isUser(clientId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isUser(userId) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Règles pour les données publiques (ex: produits, catalogues)
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && validCurrencyField()
        && ((isShop()
          && createsOwnedCommerceContent()
          && allProvidedCommerceIdentityBelongsToUser())
          || isAdmin());
      allow update: if isSignedIn()
        && validCurrencyField()
        && keepsCommerceIdentity()
        && ((isShop()
          && ownsCommerceContent()
          && existingCommerceIdentityBelongsToUser())
          || isAdmin());
      allow delete: if isSignedIn()
        && ((isShop() && ownsCommerceContent()) || isAdmin());
    }

    match /creations/{creationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && validCurrencyField()
        && ((isCreator()
          && createsOwnedCommerceContent()
          && allProvidedCommerceIdentityBelongsToUser())
          || isAdmin());
      allow update: if isSignedIn()
        && validCurrencyField()
        && keepsCommerceIdentity()
        && ((isCreator()
          && ownsCommerceContent()
          && existingCommerceIdentityBelongsToUser())
          || isAdmin());
      allow delete: if isSignedIn()
        && ((isCreator() && ownsCommerceContent()) || isAdmin());
    }

    match /stories/{storyId} {
      allow read: if isSignedIn()
        && resource.data.expiresAt > request.time;
      allow create: if isSignedIn() && createsProStory();
      allow update: if isSignedIn()
        && (isAdmin()
          || (resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.expiresAt == resource.data.expiresAt)
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stats', 'viewedBy', 'updatedAt']));
      allow delete: if isSignedIn()
        && (isAdmin() || resource.data.authorId == request.auth.uid);
    }

    match /style_guides/{guideId} {
      allow read: if isSignedIn()
        && resource.data.status == 'published'
        && resource.data.visibility == 'salon';
      allow create: if isSignedIn() && createsProStyleGuide();
      allow update: if isSignedIn()
        && (isAdmin()
          || (resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.authorRole == resource.data.authorRole));
      allow delete: if isSignedIn()
        && (isAdmin() || resource.data.authorId == request.auth.uid);
    }

    // Vide-dressing client: annonces seconde main, distinctes des comptes pros.
    match /secondhand_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'available'
        && validCurrencyField()
        && secondhandVisibilityIsEarned();
      allow update: if isSignedIn()
        && ((resource.data.sellerId == request.auth.uid
            && (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'reservedBy',
                'likedBy',
                'paymentReference',
                'paymentFlow',
                'secondhandBalance',
                'secondhandBalanceStatus',
                'settlementChoice',
                'stylePointsAwarded',
                'paymentTimeline',
                'updatedAt'
              ])
              || secondhandVisibilityIsEarned()))
          || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likedBy', 'updatedAt']))
          || (resource.data.status == 'available'
              && request.resource.data.status == 'reserved'
              && request.resource.data.reservedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'reservedBy', 'updatedAt']))
          || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /secondhand_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /product_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.productId == resource.data.productId;
      allow delete: if isAdmin();
    }
    
    // Règles pour les commandes
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || resource.data.boutiqueId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
          || isAdmin());
      allow create: if isClient()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerRole is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && validCurrencyField()
        && validClientCreatedOrder();
      allow update: if isSignedIn()
        && (sellerUpdatesOrderProgress() || clientConfirmsOrderReceipt() || isAdmin());
      allow delete: if isAdmin();
    }

    // Configuration business pilotée par l'administration.
    match /platform_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /checkout_coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /loyalty_rules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_activity_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /seller_subscriptions/{sellerId} {
      allow read: if isSignedIn() && (isUser(sellerId) || isAdmin());
      allow write: if isAdmin();
    }

    match /pro_upgrade_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && (isCreator() || isShop() || isAdmin())
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.accountId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /account_closure_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.accountId == request.auth.uid
        && request.resource.data.status in ['pending', 'closed']
        && request.resource.data.target is string
        && request.resource.data.reasonId is string
        && request.resource.data.reasonLabel is string;
      allow update, delete: if isAdmin();
    }

    match /boost_campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (isCreator() || isShop() || isAdmin())
        && request.resource.data.ownerId == request.auth.uid
        && (isAdmin() || hasActiveSignatureAccess());
      allow update: if isAdmin()
        || (
          resource.data.ownerId == request.auth.uid
          && resource.data.status == 'active'
          && request.resource.data.status == 'expired'
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.endsAt == resource.data.endsAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'expiredAt',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin();
    }

    match /platform_commissions/{commissionId} {
      allow read: if isSignedIn()
        && (isAdmin()
          || resource.data.sellerId == request.auth.uid
          || resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /seller_withdrawal_requests/{requestId} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && (canCreateOrderWithdrawalRequest() || canCreateSecondhandWithdrawalRequest())
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency is string
        && request.resource.data.status == 'pending_admin_transfer';
      allow update, delete: if isAdmin();
    }

    // Gamification client: quiz quotidien, fallback, historique et anti-répétition
    match /daily_quizzes/{userId}/days/{dayId} {
      allow read, write: if isSignedIn() && (isUser(userId) || isAdmin());
    }

    match /daily_missions/{userId}/missions/{missionId} {
      allow read, write: if isSignedIn() && (isUser(userId) || isAdmin());
    }

    match /quiz_history/{userId}/daily_results/{resultId} {
      allow read, write: if isSignedIn() && (isUser(userId) || isAdmin());
    }

    match /used_questions/{userId} {
      allow read, write: if isSignedIn() && (isUser(userId) || isAdmin());
    }

    match /fashion_events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /salon_places/{placeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // File d'emails transactionnels. L'application peut seulement créer et
    // vérifier son email de bienvenue; l'envoi réel est géré par une extension
    // Firebase ou un service serveur.
    match /mail/{mailId} {
      allow get: if isSignedIn()
        && (mailId == 'welcome_' + request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && mailId == 'welcome_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'welcome'
        && request.resource.data.to is list
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (isAdmin()
          || resource.data.userId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || resource.data.boutiqueId == request.auth.uid
          || resource.data.creatorId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.recipientId is string
        && request.resource.data.title is string
        && request.resource.data.body is string;
      allow update, delete: if isSignedIn()
        && (isAdmin()
          || resource.data.userId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
    }

    // File serveur pour l'envoi push FCM. Une Cloud Function ou un backend lit
    // ces documents, récupère les tokens du destinataire puis marque l'envoi.
    match /notification_outbox/{outboxId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.status == 'queued';
      allow read, update, delete: if isAdmin();
    }

    // Registre central des médias Cloudinary. Les documents publics gardent
    // seulement les URLs nécessaires, les preuves et fichiers privés restent
    // visibles par leur propriétaire et l'administration.
    match /media_assets/{mediaId} {
      allow read: if isSignedIn()
        && (resource.data.status == 'public'
          || resource.data.ownerId == request.auth.uid
          || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Sous-collections privées utilisateur: garde-robe, souhaits, préférences,
    // historiques et contenus personnels.
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && (isUser(userId) || isAdmin());
    }
    
    // Messagerie: les échanges peuvent être pro-client ou client-client
    // (vide-dressing). Les participants gardent la main sur leur discussion.
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isSignedIn()
        && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
    }

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && isConversationParticipant(resource.data.idConversation);
      allow create: if isSignedIn()
        && request.resource.data.idExpediteur == request.auth.uid
        && request.resource.data.idDestinataire is string
        && request.resource.data.idDestinataire.size() > 0
        && request.resource.data.idConversation is string
        && isConversationParticipant(request.resource.data.idConversation)
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.idConversation))
          .data.participants.hasAll([
            request.auth.uid,
            request.resource.data.idDestinataire
          ]);
      allow update: if isSignedIn()
        && isConversationParticipant(resource.data.idConversation)
        && request.resource.data.idConversation == resource.data.idConversation
        && request.resource.data.idExpediteur == resource.data.idExpediteur
        && request.resource.data.idDestinataire == resource.data.idDestinataire
        && (resource.data.idExpediteur == request.auth.uid
          || resource.data.idDestinataire == request.auth.uid
          || isAdmin());
      allow delete: if isSignedIn()
        && (isConversationParticipant(resource.data.idConversation)
          || isAdmin());
    }

    function isConversationParticipant(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.participants.hasAny([request.auth.uid]);
    }

    // Ancien canal chat conservé pour compatibilité.
    match /chats/{chatId} {
      allow read: if isSignedIn() && isParticipant(chatId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    function isParticipant(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
    }
  }
}
